# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted
APP_URL=

# DATABASE: Hosted PostgreSQL connection string (Supabase, Neon, AWS RDS, GCP Cloud SQL, Render, Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# AUTHENTICATION & SECURITY
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=

# PAYU PAYMENT GATEWAY (Hosted Web Checkout India)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_WEBHOOK_SECRET=
PAYU_ENV=

# NOTIFICATIONS: EMAIL (Resend or SMTP)
RESEND_API_KEY=
EMAIL_FROM=

# NOTIFICATIONS: SMS / WHATSAPP (e.g. Gupshup / Twilio / MSG91)
SMS_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=


